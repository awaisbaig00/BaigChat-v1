PORT=3001
CORS_ORIGIN=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# SESSION_SECRET: must be at least 64 characters, random, never a placeholder.
# Generate with: openssl rand -hex 64
SESSION_SECRET=

# DATA_DIR: Base directory for SQLite database, uploaded files, and avatars.
# Default locally: ./data
# Container/Production: /data (mount your persistent volume here)
DATA_DIR=./data

# Optional path overrides (defaults to subpaths under DATA_DIR if unset):
# DB_PATH=./data/data.db
# UPLOADS_DIR=./data/uploads
# AVATARS_DIR=./data/avatars

# NODE_ENV: set to "production" in production deployments
# NODE_ENV=production
