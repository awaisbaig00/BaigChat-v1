PORT=3001
CORS_ORIGIN=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# SESSION_SECRET: must be at least 64 characters, random, never a placeholder.
# Generate with: openssl rand -hex 64
SESSION_SECRET=

# Optional: path to SQLite database file (default: data.db in server/ directory)
# DB_PATH=/opt/baigchat/data.db

# Optional: directories for uploaded files and avatars
# UPLOADS_DIR=/opt/baigchat/uploads
# AVATARS_DIR=/opt/baigchat/avatars

# NODE_ENV: set to "production" in production deployments
# NODE_ENV=production
